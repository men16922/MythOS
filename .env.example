# Mythos 2.0 — copy to .env (never commit .env). Everything is optional: with nothing set, `make api` serves the
# game with authored GM text and in-memory saves.

# --- AI GM, local (default) ---------------------------------------------------------------------------------------
# OpenAI-compatible endpoint (Ollama). The GM writes 1-3 sentences per call, so an 8B model is plenty.
OLLAMA_BASE_URL=http://localhost:11434/v1
# The installed model on the dev Mac is gemma4:8b-64k (gemma4:latest is not pulled).
OLLAMA_MODEL_STORY=gemma4:8b-64k
# ollama | vllm | mlx | llamacpp — which OpenAI-compatible server it is (ollama disables the reasoning pass).
MYTHOS_LLM_ENGINE=ollama
# MYTHOS_V2_GM=off              # switch the GM off entirely (authored lines only)
# MYTHOS_V2_GM_MODEL=           # override the local model for the GM only

# --- AI GM, cloud (Cloud Run) -------------------------------------------------------------------------------------
# "vertex" runs the GM on Gemini via Vertex AI (ADC: `gcloud auth application-default login`). BILLED.
MYTHOS_NARRATIVE_PROVIDER=ollama
PROJECT_ID=
# gemini-3.x is served from the global endpoint (resolved automatically).
MODEL=gemini-3.5-flash
# GEMINI_THINKING_BUDGET=0

# --- saves ---------------------------------------------------------------------------------------------------------
# Postgres for /api/v2 saves (`make dev-up`); without it saves live in memory (the browser keeps its own copy).
POSTGRES_USER=mythos
POSTGRES_PASSWORD=mythos
POSTGRES_DB=mythos
DATABASE_URL=postgresql://mythos:mythos@localhost:5432/mythos

# --- access ---------------------------------------------------------------------------------------------------------
# Closed beta: comma-separated invite keys; empty = open. Never commit real keys.
MYTHOS_INVITE_KEYS=
# Origins allowed to call the API cross-origin (the Android app's WebView is https://localhost).
# MYTHOS_CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# --- server ---------------------------------------------------------------------------------------------------------
# MYTHOS_API_HOST=127.0.0.1
# MYTHOS_API_PORT=8000
MYTHOS_LOG_LEVEL=INFO
