# Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SECONDS=4.5

# Single-model fallback (used when STORY/PARSER below are unset).
OLLAMA_MODEL=gemma4:latest

# Dual-model narrative orchestration (see docs/plans/2026-06-10-dual-model-...md):
#   STORY  = free-text storyteller (prose quality).
#   PARSER = structures the story text into JSON (non-streaming path only; the live
#            streaming path parses with a regex, so the parser model rarely runs).
# RAM note (48GB machine): gemma4:26b (18GB) does not fit alongside FLUX image gen
# and swaps — TTFT 30-120s. gemma4:latest (8B, 9.6GB) fits resident, warm TTFT ~9s,
# and a head-to-head showed its Korean cyber-mythic prose is competitive. So 8B is
# the default storyteller; bump STORY to gemma4:26b only on a 64GB+ machine.
OLLAMA_MODEL_STORY=gemma4:latest
OLLAMA_MODEL_PARSER=qwen2.5:3b-instruct

# --- Narrative provider selection --------------------------------------------
# Which LLM drives the Narrative Director. "ollama" (default, local dev) uses the
# dual-model path above. "gemini"/"vertex" uses Google's Gemini via controlled
# generation (one call, schema-guaranteed JSON — no parser/repair round-trip) for
# the GCP closed beta. Requires `pip install -e .[gemini]`.
MYTHOS_NARRATIVE_PROVIDER=ollama

# Gemini / Vertex AI (only used when MYTHOS_NARRATIVE_PROVIDER=gemini|vertex).
# Names below are the google-genai SDK's NATIVE env vars (the SDK auto-reads
# GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION). The
# runtime also accepts the GEMINI_*-namespaced aliases in parentheses.
# Auth mode A — Vertex AI (default): ADC / service account + a GCP project.
#   gcloud auth application-default login  (or set GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_GENAI_USE_VERTEXAI=true            # alias: GEMINI_USE_VERTEX
GOOGLE_CLOUD_PROJECT=                     # alias: PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
# Narrative model (alias: GEMINI_MODEL). Default gemini-3.5-flash since the
# 2026-07-17 A/B verdict (2.5-base hybrid rolled back: owner-felt normal-turn
# prose quality drop — DECISIONS.md; ~$1.0/loop accepted). 3.x models auto-route
# to the "global" endpoint (regional 404s; Imagen keeps using
# GOOGLE_CLOUD_LOCATION). Override the narrative region with GEMINI_LOCATION.
# ⚠️ 3.5-flash ≈ 5x input price vs 2.5-flash ($1.50/$9 vs $0.30/$2.50 per M tokens).
MODEL=gemini-3.5-flash
# Optional key-beat model split (alias: MODEL_KEYBEAT): key-beat turns (opening /
# anchor locks / cutscenes / boss buildup / endings) generate on this model, normal
# turns on MODEL. Tried 2026-07-14..17 (MODEL=2.5 + keybeat 3.5 ≈ $0.5/loop) and
# ROLLED BACK on quality; routing stays wired for future retries. Unset = single model.
# If either model is gemini-3.x the shared endpoint resolves to "global".
# GEMINI_MODEL_KEYBEAT=gemini-3.5-flash
# Auth mode B — Gemini Developer API: set GOOGLE_GENAI_USE_VERTEXAI=false + an API key.
# GOOGLE_API_KEY=                          # alias: GEMINI_API_KEY
# Sampling / output budget.
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
# Gemini 2.5 thinking budget. 0 = OFF (default) — for controlled structured generation
# reasoning is unneeded and, left on, its tokens drain max_output_tokens and truncate the
# JSON (intermittent parse failure). Set >0 to re-enable, or -1 for the model's dynamic budget.
GEMINI_THINKING_BUDGET=0

# --- Cloud image + storage (GCP closed beta) ---------------------------------
# Image backend: local FLUX/mflux by default; set to vertex|imagen for cloud image gen
# (reuses the Gemini google-genai SDK + the GOOGLE_* creds above). pip install -e .[gemini]
# MYTHOS_VISUAL_PROVIDER=vertex
# gemini-*-image → generate_content w/ the curated portrait as a reference (character
# consistency; the supported path since imagen-3.0-* retired). imagen-* uses the legacy
# text-to-image path. Keep the GA 2.5 model as the portable default; newer preview
# aliases can require per-project or per-region access.
IMAGEN_MODEL=gemini-2.5-flash-image
# Asset storage backend: minio (default, local) | gcs | filesystem. pip install -e .[gcs]
# MYTHOS_STORAGE_BACKEND=gcs
# GCS bucket for assets (falls back to S3_BUCKET_ASSETS if unset).
# GCS_BUCKET_ASSETS=mythos-assets

# --- Closed-beta invite gating -----------------------------------------------
# Comma-separated allowed invite keys. When SET, /api/v1/* (except /health) requires
# a valid key via the X-Invite-Key header or ?invite= query (WS uses ?invite=). When
# UNSET (default), the API is fully open. Give testers a link: https://<app>/?invite=KEY
# MYTHOS_INVITE_KEYS=key-alpha,key-beta
# Per-player loop cap (int, 0/unset = unlimited). Caps NEW loops started per player —
# the variable-cost ceiling (each loop ≈ 30 Gemini turns + ~5-15 Imagen images). Over
# the cap a new begin returns 429 (REST) / an error frame (WS); resume is unaffected.
# MYTHOS_MAX_LOOPS_PER_PLAYER=10   # closed-beta adopted value (~5-7.5h / ~$3-7 per tester)

# Diffusers image model from ROUGH.md.
IMAGE_MODEL_ID=black-forest-labs/FLUX.1-schnell
OUTPUT_DIR=outputs

# Image backend: "mflux" (Apple MLX — ~20x faster + lower memory via quantization;
# default) or "diffusers" (PyTorch/MPS fallback). Same FLUX.1-schnell weights either way.
IMAGE_BACKEND=mflux
# MLX quantization bits for the mflux backend: 8 (better quality, ~12GB) or 4 (~7GB).
MFLUX_QUANTIZE=8

# Required for gated Hugging Face models such as black-forest-labs/FLUX.1-schnell.
# 1) Accept the model access terms on Hugging Face.
# 2) Create a read token and paste it here, or run `hf auth login`.
# HF_TOKEN=hf_...

# Apple Silicon / MPS defaults.
PYTORCH_ENABLE_MPS_FALLBACK=1

# Use only if you hit RuntimeError: MPS backend out of memory.
# This removes PyTorch's MPS memory guardrail and can make the system swap hard.
# PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0

# --- Local Docker infra (docker-compose.local.yml) ---------------------------
# These power the stateful stores. Ollama and FLUX still run on the host.

# PostgreSQL. POSTGRES_* are read by the postgres container; DATABASE_URL is the
# host-side connection string used by the runtime.
POSTGRES_USER=mythos
POSTGRES_PASSWORD=mythos
POSTGRES_DB=mythos
DATABASE_URL=postgresql://mythos:mythos@localhost:5432/mythos


# MinIO (S3-compatible object storage). S3_ACCESS_KEY/S3_SECRET_KEY also set the
# MinIO root credentials in the container.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mythos
S3_SECRET_KEY=mythos-local-secret
S3_BUCKET_ASSETS=mythos-assets
S3_BUCKET_EXPORTS=mythos-session-exports

# OpenTelemetry export target (otel-collector OTLP HTTP endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Trace backend: otlp (default, local collector) | gcp (Cloud Trace, needs [gcp] +
# the Cloud Run SA's roles/cloudtrace.agent) | none (disable — use on Cloud Run if no
# collector so the OTLP exporter doesn't retry against an absent endpoint).
# MYTHOS_TRACE_BACKEND=otlp
MYTHOS_ENV=local
# Set to 1/true/on to enable DEBUG logs. MYTHOS_LOG_LEVEL still wins when set.
MYTHOS_DEBUG=0
# Optional global override. Player View uses fast behavior by default; Developer View
# and CLI can disable it for quality/QA. Set this only to force process-wide defaults.
# MYTHOS_FAST_MODE=0
# Optional explicit log level: DEBUG, INFO, WARNING, ERROR.
# MYTHOS_LOG_LEVEL=INFO

# BGM auto-start default served to the SPA via /api/v1/client-config. Defaults to
# true (production); `make api` / `make api-cloud` export false so local test runs
# stay silent. A user's in-app BGM toggle always wins over this default.
# DEFAULT_BGM_ON=true

# If the runtime ever runs inside a container instead of on the host, point it at
# the host-served Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
