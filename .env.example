# Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SECONDS=4.5

# Single-model fallback (used when STORY/PARSER below are unset).
OLLAMA_MODEL=gemma4:latest

# Dual-model narrative orchestration (see docs/plans/2026-06-10-dual-model-...md):
#   STORY  = free-text storyteller (prose quality).
#   PARSER = structures the story text into JSON (non-streaming path only; the live
#            streaming path parses with a regex, so the parser model rarely runs).
# RAM note (48GB machine): gemma4:26b (18GB) does not fit alongside FLUX image gen
# and swaps — TTFT 30-120s. gemma4:latest (8B, 9.6GB) fits resident, warm TTFT ~9s,
# and a head-to-head showed its Korean cyber-mythic prose is competitive. So 8B is
# the default storyteller; bump STORY to gemma4:26b only on a 64GB+ machine.
OLLAMA_MODEL_STORY=gemma4:latest
OLLAMA_MODEL_PARSER=qwen2.5:3b-instruct

# Diffusers image model from ROUGH.md.
IMAGE_MODEL_ID=black-forest-labs/FLUX.1-schnell
OUTPUT_DIR=outputs

# Image backend: "mflux" (Apple MLX — ~20x faster + lower memory via quantization;
# default) or "diffusers" (PyTorch/MPS fallback). Same FLUX.1-schnell weights either way.
IMAGE_BACKEND=mflux
# MLX quantization bits for the mflux backend: 8 (better quality, ~12GB) or 4 (~7GB).
MFLUX_QUANTIZE=8

# Required for gated Hugging Face models such as black-forest-labs/FLUX.1-schnell.
# 1) Accept the model access terms on Hugging Face.
# 2) Create a read token and paste it here, or run `hf auth login`.
# HF_TOKEN=hf_...

# Apple Silicon / MPS defaults.
PYTORCH_ENABLE_MPS_FALLBACK=1

# Use only if you hit RuntimeError: MPS backend out of memory.
# This removes PyTorch's MPS memory guardrail and can make the system swap hard.
# PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0

# --- Local Docker infra (docker-compose.local.yml) ---------------------------
# These power the stateful stores. Ollama and FLUX still run on the host.

# PostgreSQL. POSTGRES_* are read by the postgres container; DATABASE_URL is the
# host-side connection string used by the runtime.
POSTGRES_USER=mythos
POSTGRES_PASSWORD=mythos
POSTGRES_DB=mythos
DATABASE_URL=postgresql://mythos:mythos@localhost:5432/mythos

# Redis (job queue, locks, transient state).
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage). S3_ACCESS_KEY/S3_SECRET_KEY also set the
# MinIO root credentials in the container.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mythos
S3_SECRET_KEY=mythos-local-secret
S3_BUCKET_ASSETS=mythos-assets
S3_BUCKET_EXPORTS=mythos-session-exports

# OpenTelemetry export target (otel-collector OTLP HTTP endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MYTHOS_ENV=local
# Set to 1/true/on to enable DEBUG logs. MYTHOS_LOG_LEVEL still wins when set.
MYTHOS_DEBUG=0
# Optional global override. Player View uses fast behavior by default; Developer View
# and CLI can disable it for quality/QA. Set this only to force process-wide defaults.
# MYTHOS_FAST_MODE=0
# Optional explicit log level: DEBUG, INFO, WARNING, ERROR.
# MYTHOS_LOG_LEVEL=INFO

# If the runtime ever runs inside a container instead of on the host, point it at
# the host-served Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
