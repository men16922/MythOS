<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain-http to a local API (`make api` on the host, reached from the emulator as 10.0.2.2,
     or `adb reverse tcp:8010 tcp:8010` → localhost). Release builds keep Android's default: HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
